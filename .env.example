# Telegram API credentials (required for Telegram collector)
# Get these from https://my.telegram.org
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# YouTube (optional, no API key needed - uses yt-dlp)
# Requires a JavaScript runtime (deno recommended) to extract comments.
# Install deno: irm https://deno.land/install.ps1 | iex
# No configuration required here.
