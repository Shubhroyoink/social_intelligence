# Telegram API credentials (required for Telegram collector)
# Get these from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# YouTube Data API v3 key (required for YouTube collector)
# Used to fetch video comments via the official YouTube Data API.
# Get one from https://console.cloud.google.com/apis/library/youtube.googleapis.com
# (enable the "YouTube Data API v3", then create an API key).
YOUTUBE_API_KEY=

# Google Gemini API key (optional — used for the narrative report stage)
# Get one from https://aistudio.google.com/apikey
# If unset, the pipeline falls back to a deterministic template report.
LLM_API_KEY=

# Optional: Gemini model to use for narrative generation (default: gemini-3.5-flash)
# Note: gemini-2.5-flash is retired for new API users.
LLM_MODEL=gemini-3.5-flash
